# Copie para ".env" e preencha. Nunca suba o ".env" real para um repositorio publico.

PORT=3000

# Conexao com o PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/carwoo

# Chave que assina os tokens de login. Gere com: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Enderecos autorizados a chamar a API (separados por virgula)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ---- Armazenamento das fotos dos veiculos ----
# Sem isto as fotos NAO ficam salvas: somem ao recarregar a pagina, e nenhum
# portal aceita o anuncio, porque OLX e Mercado Livre exigem link de imagem.
#
# Como preencher (voce ja tem conta no Supabase, e o mesmo projeto do banco):
#   1. Abra o painel do Supabase e entre no seu projeto
#   2. Va em Project Settings > API
#   3. "Project URL" vai em SUPABASE_URL
#   4. Em "Project API keys", copie a chave "service_role" (nao a "anon")
#
# A chave service_role da acesso total ao projeto: e por isso que ela fica
# no servidor, dentro deste arquivo, e nunca no HTML que o navegador baixa.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Nome da pasta onde as fotos ficam. O sistema cria sozinho na primeira foto.
SUPABASE_BUCKET=veiculos

# ---- Emissao de nota fiscal (opcional) ----
# Preencha somente quando contratar um provedor com certificado digital.
# Provedores comuns: focusnfe, enotas, nfeio, bling, omie
FISCAL_PROVIDER=
FISCAL_TOKEN=
FISCAL_API_URL=
# Segredo que o provedor devolve no header x-webhook-secret
FISCAL_WEBHOOK_SECRET=

# ---- Cobranca de assinaturas (opcional) ----
# Preencha quando contratar um gateway de pagamento.
# Opcoes no Brasil: asaas, vindi, iugu, pagarme, mercadopago, stripe
BILLING_PROVIDER=
BILLING_TOKEN=
BILLING_API_URL=
# Segredo que o gateway envia no header do webhook
BILLING_WEBHOOK_SECRET=

# ---- Entrada de leads e notificacoes ----
# Endereco publico do servidor, usado para montar as URLs de webhook
PUBLIC_URL=

# Chaves VAPID para push no PWA (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Envio de e-mail (recuperacao de senha) ----
# Opcoes: resend, sendgrid, postmark, ses, brevo
MAIL_PROVIDER=
MAIL_TOKEN=
MAIL_FROM=nao-responda@sualoja.com.br
# Endereco onde o front-end esta publicado (usado no link de redefinicao)
APP_URL=http://localhost:8080
